              "type": "Label",
              "properties": { "title": "Steps", "systemImage": "ellipsis.circle" }
            },
            "children": [
              { "type": "Button", "id": 311, "properties": { "title": "Sign for Release", "systemImage": "signature", "actionID": "Notarize.sign" } },
              { "type": "Button", "id": 312, "properties": { "title": "Check Signature", "systemImage": "magnifyingglass", "actionID": "Notarize.check" } },
              { "type": "Button", "id": 313, "properties": { "title": "Submit and Wait", "systemImage": "arrow.up.circle", "actionID": "Notarize.submit" } },
              { "type": "Button", "id": 314, "properties": { "title": "Fetch Last Log", "systemImage": "doc.text", "actionID": "Notarize.log" } },
              { "type": "Button", "id": 315, "properties": { "title": "Staple Ticket", "systemImage": "paperclip", "actionID": "Notarize.staple" } },
              { "type": "Button", "id": 316, "properties": { "title": "Validate Result", "systemImage": "checkmark.shield", "actionID": "Notarize.validate" } }
            ]
          },
          {
            "type": "Button",
            "id": 32,
            "properties": {
              "title": "Cancel",
              "systemImage": "stop.circle",
              "actionID": "Notarize.cancel",
              "disabled": true,
              "help": "Stop the current operation"
            }
          },
          {
            "type": "Button",
            "id": 33,
            "properties": {
              "title": "Credentials",
              "systemImage": "key",
              "actionID": "Notarize.creds.open",
              "help": "Set up notary service credentials"
            }
          }
        ]
      }
    ],
    "children": [
