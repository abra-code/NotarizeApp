                      { "type": "Button", "id": 53, "properties": { "title": "Browse...", "actionID": "Notarize.choose.entitlements" } }
                    ]
                  },
                  {
                    "type": "HStack",
                    "properties": { "spacing": 8 },
                    "children": [
                      { "type": "Text", "properties": { "text": "Output folder", "foregroundStyle": "secondary", "frame": { "width": 130, "alignment": "trailing" } } },
                      { "type": "TextField", "id": 54, "properties": { "text": "", "prompt": "Defaults to the app's folder", "font": { "size": 11, "design": "monospaced" }, "frame": { "maxWidth": "infinity" } } },
                      { "type": "Button", "id": 55, "properties": { "title": "Browse...", "actionID": "Notarize.choose.output" } }
                    ]
                  },
                  {
                    "type": "HStack",
                    "properties": { "spacing": 16 },
                    "children": [
                      { "type": "Toggle", "id": 56, "properties": { "title": "Sign for release first" } },
                      { "type": "Toggle", "id": 57, "properties": { "title": "Staple ticket" } },
                      { "type": "Toggle", "id": 58, "properties": { "title": "Create distribution zip" } }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "GroupBox",
            "properties": { "title": "Progress", "frame": { "maxWidth": "infinity", "maxHeight": "infinity" } },
            "children": [
              {
                "type": "VStack",
                "properties": { "spacing": 6, "frame": { "maxWidth": "infinity", "maxHeight": "infinity" } },
                "children": [
                  {
                    "type": "HStack",
                    "properties": { "spacing": 8 },
                    "children": [
                      { "type": "Text", "id": 60, "properties": { "text": "Drop an app to notarize, or choose one.", "font": "footnote", "foregroundStyle": "secondary", "frame": { "maxWidth": "infinity", "alignment": "leading" } } },
                      { "type": "ProgressView", "id": 61, "properties": { "controlSize": "small", "hidden": true } }
                    ]
                  },
                  {
                    "type": "TextEditor",
                    "id": 62,
                    "properties": {
                      "readOnly": true,
                      "font": { "size": 11, "design": "monospaced" },
                      "background": "background.secondary",
                      "scrollContentBackground": "hidden",
                      "frame": { "minHeight": 200, "maxWidth": "infinity", "maxHeight": "infinity" }
                    }
                  },
                  {
                    "type": "HStack",
                    "properties": { "spacing": 8 },
                    "children": [
                      { "type": "Spacer" },
                      { "type": "Button", "id": 63, "properties": { "title": "Reveal in Finder", "systemImage": "magnifyingglass", "actionID": "Notarize.reveal", "hidden": true } }
                    ]
                  }
                ]
              }
            ]
          }
        ]
