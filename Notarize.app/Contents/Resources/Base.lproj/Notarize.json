                    ]
                  },
                  {
                    "type": "HStack",
                    "properties": { "spacing": 8 },
                    "children": [
                      { "type": "Text", "properties": { "text": "Credential profile", "foregroundStyle": "secondary", "frame": { "width": 130, "alignment": "trailing" } } },
                      { "type": "Picker", "id": 51, "properties": { "title": "", "pickerStyle": "menu", "options": [], "frame": { "maxWidth": "infinity" } } }
                    ]
                  },
                  {
                    "type": "HStack",
                    "properties": { "spacing": 8 },
