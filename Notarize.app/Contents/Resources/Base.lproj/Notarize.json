{
  "type": "NavigationStack",
  "content": {
    "type": "VStack",
    "properties": {
      "spacing": 0,
      "frame": {
        "minWidth": 640,
        "minHeight": 520,
        "idealWidth": 780,
        "idealHeight": 640,
