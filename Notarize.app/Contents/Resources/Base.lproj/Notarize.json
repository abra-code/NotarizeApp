          {
            "type": "Button",
            "id": 30,
            "properties": {
              "title": "Notarize",
              "systemImage": "checkmark.seal",
              "actionID": "Notarize.run",
              "disabled": true,
              "help": "Sign, submit, wait, staple, and package the app for distribution"
            }
          },
          {
            "type": "Menu",
            "id": 31,
            "properties": {
              "title": "Steps",
              "disabled": true,
              "help": "Run an individual step"
